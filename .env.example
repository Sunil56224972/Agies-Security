# Copy to .env and fill in what applies to you. Restart after changes.
# Settings > Integrations in the console shows what the server picked up.

# --- Server ------------------------------------------------------------------
PORT=3000
HOST=0.0.0.0
# Public address of the console, used for links in Slack / Teams / webhook messages.
# Defaults to the address the request came in on.
PUBLIC_URL=
NODE_ENV=production
# 32+ random characters. If empty, one is generated into .data/session.secret.
# Set it explicitly when you run more than one instance behind a load balancer.
SESSION_SECRET=
# Set to 1 when served over HTTPS (it should be, outside localhost).
COOKIE_SECURE=0
# Behind nginx / a load balancer: number of proxy hops, or "loopback".
TRUST_PROXY=
# Required on the first-run screen when set. Recommended for any reachable host,
# so nobody else can claim the administrator account before you do.
AEGIS_SETUP_TOKEN=
LOGIN_RATE_LIMIT=10
API_RATE_LIMIT=1200

# --- Storage -----------------------------------------------------------------
# Supabase Postgres. Apply every file in supabase/migrations first.
# Use the secret key (sb_secret_...) or the legacy service_role JWT: the server
# is the only client, and the anon / publishable key is denied on every table.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Without Supabase the server keeps data in .data/aegis.json (single node).
# AEGIS_DATA_FILE=.data/aegis.json
# By default the server refuses to start if Supabase is configured but
# unreachable. Set to 1 to fall back to the local file instead.
AEGIS_ALLOW_FALLBACK=0

# --- Enforcement ---------------------------------------------------------------
# Where containment rules go:
#   feed        firewalls pull /api/feeds/blocklist.txt and isolate.txt (default)
#   webhook     POST each rule to your SOAR / firewall automation, HMAC signed
#   cloudflare  Cloudflare IP Access Rules on one zone (BLOCK only)
#   record      store rules in Aegis only; apply them by hand
ENFORCEMENT_MODE=feed
ENFORCEMENT_WEBHOOK_URL=
ENFORCEMENT_WEBHOOK_SECRET=
# Token needs Zone > Firewall Services > Edit on the zone.
CF_API_TOKEN=
CF_ZONE_ID=

# --- Threat intel ------------------------------------------------------------
# https://nvd.nist.gov/developers/request-an-api-key  (raises the rate limit 10x,
# and lets "Find CVEs" on a host check 12 packages per run instead of 4)
NVD_API_KEY=
# IP reputation works without keys (Spamhaus, FireHOL, Tor, GreyNoise, Shodan
# InternetDB, ipwho.is). AbuseIPDB adds report counts when a key is set.
# https://www.abuseipdb.com/account/api
ABUSEIPDB_API_KEY=
# Set to off on an air-gapped install to skip every outbound intel lookup.
AEGIS_INTEL=on
# abuse.ch (ThreatFox, URLhaus, MalwareBazaar, Feodo, SSLBL), MISP OSINT, RDAP,
# RIPEstat, Mnemonic passive DNS and crt.sh need no key. Optional extras:
# VirusTotal community key (500 lookups/day): https://www.virustotal.com/gui/my-apikey
VT_API_KEY=
# abuse.ch Auth-Key, enables live URLhaus/MalwareBazaar/ThreatFox API queries
# on top of the bulk exports: https://auth.abuse.ch/
ABUSECH_AUTH_KEY=
# AlienVault OTX works without a key; a free key raises the rate limit:
# https://otx.alienvault.com/api
OTX_API_KEY=
# Hybrid Analysis (Falcon sandbox verdicts for file hashes), free account:
# https://www.hybrid-analysis.com/my-account?tab=%23api-key-tab
HYBRID_ANALYSIS_API_KEY=
# Your own MISP instance (searched on every lookup alongside the public feed).
MISP_URL=
MISP_KEY=
# SigmaHQ community rules, matched against every ingested log batch.
AEGIS_SIGMA=on
# SIGMA_RULES_URL=https://github.com/SigmaHQ/sigma/releases/latest/download/sigma_all_rules.zip

# --- LLM agent (optional) ----------------------------------------------------
# Without a key the rule-based playbook runs every investigation. Free key:
# https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# --- Jira (optional) -----------------------------------------------------------
# Lets analysts open a Jira issue from a case and sync its status back.
# API token: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT=
JIRA_ISSUE_TYPE=Task

# --- Demo ----------------------------------------------------------------------
# Loads six sample incidents and enables Settings > Reset. Never in production.
AEGIS_DEMO=0
# --- MCP server ----------------------------------------------------------------
# Calls per minute per address on /mcp (keys with the mcp or mcp:write scope).
MCP_RATE_LIMIT=300
