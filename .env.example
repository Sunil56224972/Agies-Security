# Copy to .env and fill in what you have. Everything is optional:
# with no Supabase credentials the server runs on a local file sandbox.

# --- Supabase (persistent backend) -------------------------------------------
# Project settings -> API. Use the service role key: the server is the only
# client, and row level security blocks the anon key on every table.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --- Groq (optional LLM investigation agent) ---------------------------------
# Without a key the deterministic playbook runs every investigation.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

PORT=3000