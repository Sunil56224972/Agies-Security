# ==============================================================================
# Aegis Security — Environment Configuration Template
# ==============================================================================

# Groq Cloud API Key (Get a free key at https://console.groq.com)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Groq Model Identifier (default: llama-3.3-70b-versatile)
# Supported options: llama-3.3-70b-versatile, llama-3.1-70b-versatile, llama-3.1-8b-instant
GROQ_MODEL=llama-3.3-70b-versatile

# Web Platform Port
PORT=3000

# Neon Serverless PostgreSQL Database Connection String
# 1. Create a free PostgreSQL instance at https://neon.tech
# 2. Copy the connection string and paste below:
DATABASE_URL=postgresql://neondb_owner:your_password@ep-your-instance.aws.neon.tech/neondb?sslmode=require

# Database Initialization:
# - The server automatically executes CREATE TABLE IF NOT EXISTS for all 11 tables
#   and seeds default CMDB assets, CVEs, and NIDS alerts on first boot.
# - Alternatively, you can run `init_db.sql` directly inside the Neon SQL Editor.
